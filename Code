# 3. AI AGENT & ANALYSIS ENGINES
def ai_career_agent(text_low, skills, level):
    """
    Simulated AI Agent Logic: 
    Performs Autonomous Gap Analysis and Roadmap Generation.
    """
    roadmap = []
    gap_analysis = ""
    
    # Logic for Gap Analysis
    if "llm" not in text_low and level == "High":
        gap_analysis = "Missing Generative AI foundations required for modern Lead roles."
        roadmap = ["Step 1: Complete 'Optimized Data Preparation for Large-Scale LLMs'", 
                   "Step 2: Implement a RAG-based Portfolio Project",
                   "Step 3: Apply for AI Architect Positions"]
    elif "sql" not in text_low:
        gap_analysis = "Database query skills are missing, which is a bottleneck for data roles."
        roadmap = ["Step 1: Master SQL Join operations", 
                   "Step 2: Connect Python to PostgreSQL",
                   "Step 3: Build a Data Warehouse project"]
    else:
        gap_analysis = "Solid foundation detected. Lacks niche specialization in advanced analytics."
        roadmap = ["Step 1: Specialize in Advanced Data Visualization", 
                   "Step 2: Learn Cloud Deployment (AWS/Azure)",
                   "Step 3: Target Senior Data Analyst roles"]
        
    return gap_analysis, roadmap

def analyze_full_profile(text):
    text_low = text.lower()
    
    # --- ATS SCORE (Weighted Heuristic Scoring) ---
    score = 0
    feedback = []
    for sec in ['experience', 'education', 'project', 'skill']:
        if sec in text_low: score += 10
        else: feedback.append(f"Missing {sec.title()} section.")
    
    tech_kws = ['python', 'sql', 'java', 'excel', 'tableau', 'machine learning', 'llm', 'data']
    found_tech = [t.title() for t in tech_kws if t in text_low]
    score += (len(found_tech) * 7)
    if "@" in text_low: score += 20
    
    # --- LEVELING LOGIC ---
    is_high = any(w in text_low for w in ['senior', 'lead', 'manager', 'specialist', '5+', 'architect'])
    level = "High" if is_high else "Middle"
    
    # --- AI AGENT INSIGHTS ---
    gap, roadmap = ai_career_agent(text_low, found_tech, level)
    
    return {
        "score": min(score, 100),
        "feedback": feedback,
        "skills": found_tech,
        "level": level,
        "agent_gap": gap,
        "agent_roadmap": roadmap
    }

